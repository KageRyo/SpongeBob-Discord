{
  "name": "spongebob-discord",
  "version": "1.0.1",
  "description": "Discord bot for SpongeBob meme lookup powered by Google Sheets.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start:bg": "bash scripts/start-background.sh",
    "stop:bg": "bash scripts/stop-background.sh",
    "status:bg": "bash scripts/status-background.sh",
    "start": "node dist/index.js",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
